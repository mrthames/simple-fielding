{
  "expo": {
    "name": "Simple Fielding",
    "slug": "simple-fielding",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thamesproductions.simplefielding",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#172A50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thamesproductions.simplefielding",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "justinthames",
    "extra": {
      "eas": {
        "projectId": "6fe3fd7f-133b-4298-b2ea-426e2757a0d5"
      }
    },
    "plugins": [
      "./plugins/with-web-app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#172A50"
        }
      ]
    ]
  }
}
